---
const waLink = "https://wa.me/51999252787?text=Hola,%20quiero%20saber%20c%C3%B3mo%20evitar%20observaciones%20en%20auditor%C3%ADas%20y%20mejorar%20el%20control%20de%20nuestros%20activos.%20Requiero%20orientaci%C3%B3n%20sobre%20c%C3%B3mo%20%C3%89ficer%20podr%C3%ADa%20ayudarnos.";
---

<section class="hero-section">
  <div class="container hero-grid">

    <!-- LEFT: copy -->
    <div class="eficer-hero eficer-hero-left">

      <div class="eficer-badge">SOFTWARE DE GESTIÓN DE ACTIVOS</div>

      <h1 class="eficer-title">
        Evita observaciones en auditorías
        <span class="eficer-orange">
          y deja de depender de
          <span class="eficer-underline">Excel</span>
        </span>
        para controlar tus activos
      </h1>

      <p class="eficer-subtitle">
        Éficer te ayuda a controlar, auditar y gestionar todos tus activos fijos
        desde una sola plataforma. Sin Excel. Sin desorden. Sin observaciones.
      </p>

      <div class="eficer-buttons">
        <a class="eficer-btn eficer-btn-whatsapp" href={waLink} target="_blank" rel="noopener">
          💬 Hablar por WhatsApp
        </a>
        <a class="eficer-btn eficer-btn-secondary" href="#como-funciona">
          ▶️ Ver Video Demostrativo
        </a>
      </div>

    </div>

    <!-- RIGHT: form -->
    <div class="eficer-form-card">
      <div class="eficer-form-header">
        <div class="header-flex">
          <div class="calendar-circle">
            <span class="calendar-icon">📅</span>
          </div>
          <div class="header-text">
            <h2>Agenda tu demostración personalizada</h2>
            <p>Completa tus datos y agenda tu demostración. Sin compromiso.</p>
          </div>
        </div>
      </div>

      <form
        class="eficer-contact-form"
        name="demo-hero"
        method="POST"
        action="/gracias"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="demo-hero" />
        <p style="display:none"><label>No completar: <input name="bot-field" /></label></p>

        <div class="form-row">
          <div class="form-group">
            <label>Nombre *</label>
            <input type="text" name="nombre_eficer" required minlength="3" />
          </div>
          <div class="form-group">
            <label>Institución / Empresa *</label>
            <input type="text" name="empresa_eficer" required minlength="3" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Teléfono *</label>
            <input type="tel" name="tel_eficer" required minlength="7" />
          </div>
          <div class="form-group">
            <label>Correo electrónico</label>
            <input type="email" name="email_eficer" required />
          </div>
        </div>

        <div class="form-group">
          <label>Mensaje opcional</label>
          <textarea name="mensaje_eficer" placeholder="Cuéntanos brevemente sobre tu institución y tus necesidades"></textarea>
        </div>

        <div class="captcha-container">
          <div class="g-recaptcha" data-sitekey="6LcxAOwsAAAAAHPBT28cbYLWHz6J0F6o_Xw_2EKr"></div>
        </div>

        <div class="eficer-security-box">
          <div class="security-icon">🔒</div>
          <div class="security-text">
            <strong>Tu información está 100% segura</strong>
            <p>No compartimos tu información con terceros.</p>
          </div>
        </div>

        <button type="submit" name="submit_eficer" class="eficer-submit-btn">
          Agendar mi demostración personalizada
        </button>

        <div class="eficer-form-footer">
          <span>⏱ Te contactamos en menos de 24 horas</span>
          <span>🛡 Sin compromiso y sin riesgo</span>
        </div>
      </form>
    </div>

  </div>
</section>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<style>
.hero-section {
  background: #04394C;
  padding: 125px 0 80px;
  min-height: 100vh;
  display: flex;
  align-items: center;
  margin-top: 0;
}
.hero-section .hero-grid {
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 575px;
  gap: 56px;
  align-items: center;
  width: 1300px;
  max-width: 100%;
  margin: 0 auto;
  padding: 0 30px;
  box-sizing: border-box;
}

/* ── LEFT ── */
.eficer-hero { animation: fadeUp .9s ease forwards; }
.eficer-hero-left { }

.eficer-badge {
  display: inline-block;
  padding: 10px 22px;
  border: 1px solid rgba(255,106,61,.55);
  background: rgba(255,106,61,.08);
  color: #FF6A3D;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 3px;
  margin-bottom: 22px;
}

.eficer-title {
  margin: 0;
  max-width: 850px;
  color: #ffffff;
  font-size: clamp(36px, 5.0vw, 66px);
  line-height: 1.15;
  font-weight: 900;
  letter-spacing: -1.5px;
  text-shadow: 0 18px 45px rgba(0,0,0,.28);
}

.eficer-orange { color: #FF6A3D; }

.eficer-underline {
  position: relative;
  display: inline-block;
}
.eficer-underline::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -8px;
  width: 100%;
  height: 5px;
  background: linear-gradient(90deg, #FF6A3D 0%, #37D6D0 100%);
  border-radius: 20px;
  box-shadow: 0 0 20px rgba(55,214,208,.35);
}

.eficer-subtitle {
  margin-top: 34px;
  max-width: 620px;
  color: rgba(255,255,255,.68);
  font-size: 20px;
  line-height: 1.65;
  font-weight: 400;
}

.eficer-buttons {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  margin-top: 44px;
}

.eficer-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60px;
  padding: 0 34px;
  border-radius: 12px;
  font-size: 17px;
  font-weight: 800;
  text-decoration: none;
  transition: all .25s ease;
  font-family: inherit;
}
.eficer-btn-whatsapp {
  color: #ffffff;
  background: linear-gradient(135deg, #FF6A3D, #F04B23);
  box-shadow: 0 18px 35px rgba(255,106,61,.35);
  border: 1px solid rgba(255,106,61,.65);
}
.eficer-btn-whatsapp:hover {
  transform: translateY(-3px);
  box-shadow: 0 24px 45px rgba(255,106,61,.45);
  color: #ffffff;
}
.eficer-btn-secondary {
  color: #ffffff;
  border: 1px solid rgba(255,255,255,.65);
  background: rgba(255,255,255,.04);
}
.eficer-btn-secondary:hover {
  transform: translateY(-3px);
  background: rgba(255,255,255,.10);
  color: #ffffff;
}

/* ── RIGHT: FORM ── */
.eficer-form-card {
  background-color: #ffffff !important;
  border-radius: 30px !important;
  padding: 34px !important;
  width: 575px;
  max-width: 100%;
  font-family: 'Montserrat', sans-serif, Arial;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.eficer-form-header { /* solo wrapper, sin estilos propios */ }

.header-flex {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 26px;
  text-align: left;
}
.calendar-circle {
  background-color: #003354;
  width: 65px;
  height: 65px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.calendar-icon { font-size: 28px; }
.header-text h2 {
  color: #003354 !important;
  font-size: 24px !important;
  font-weight: 800 !important;
  margin: 0 0 5px 0 !important;
  line-height: 1.2 !important;
}
.header-text p {
  color: #666 !important;
  font-size: 12px !important;
  margin: 0 !important;
}

.eficer-contact-form { display: flex; flex-direction: column; }

.form-row {
  display: flex;
  gap: 15px;
}
.form-group {
  flex: 1;
  margin-bottom: 12px;
}
.eficer-contact-form label {
  display: block;
  color: #003354;
  font-weight: 700;
  margin-bottom: 8px;
  font-size: 14px;
}
.eficer-contact-form input,
.eficer-contact-form textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #d1d9e0;
  background: #ffffff;
  border-radius: 10px;
  color: #333;
  font-size: 15px;
  font-family: inherit;
}
.eficer-contact-form textarea {
  height: 68px;
  resize: none;
}
.eficer-contact-form input:focus,
.eficer-contact-form textarea:focus { outline: none; border-color: #003354; }

.captcha-container {
  display: flex;
  justify-content: center;
  margin: 10px 0 20px 0;
}

.eficer-security-box {
  background-color: #f1f5f7;
  border-radius: 15px;
  padding: 15px;
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}
.security-icon { font-size: 20px; }
.security-text strong {
  color: #003354;
  font-size: 14px;
  display: block;
}
.security-text p {
  color: #666;
  font-size: 12px;
  margin: 0;
}

.eficer-submit-btn {
  width: 100%;
  background-color: #ff7043 !important;
  color: #ffffff !important;
  border: none !important;
  padding: 18px !important;
  font-weight: 800 !important;
  font-size: 17px !important;
  border-radius: 12px !important;
  cursor: pointer;
  transition: 0.3s;
  font-family: inherit;
}
.eficer-submit-btn:hover { background-color: #f4511e !important; }

.eficer-form-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
  color: #003354;
  font-size: 12px;
  font-weight: 600;
}

/* ── ANIMATION ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── RESPONSIVE ── */
@media (max-width: 1100px) {
  .hero-grid { grid-template-columns: 1fr; width: 100%; padding: 0 24px; }
  .eficer-hero-left { margin-top: 0; }
  .eficer-form-card { width: 100% !important; max-width: 600px; margin: 0 auto; }
  .eficer-title { font-size: 52px; }
}
@media (max-width: 767px) {
  .hero-section { padding: 90px 0 50px; }
  .hero-grid { padding: 0 18px; gap: 36px; }
  .eficer-badge { font-size: 11px; letter-spacing: 2px; }
  .eficer-title { font-size: 36px; letter-spacing: -1px; line-height: 1.2; }
  .eficer-subtitle { font-size: 16px; }
  .eficer-buttons { flex-direction: column; gap: 12px; }
  .eficer-btn { width: 100%; text-align: center; justify-content: center; }
  .eficer-form-card { width: 100% !important; max-width: 100% !important; }
  .form-row { flex-direction: column; gap: 0; }
  .header-flex { flex-direction: column; text-align: center; }
  .eficer-form-card { padding: 20px !important; }
  .eficer-form-footer { flex-direction: column; align-items: center; gap: 5px; }
}
@media (max-width: 480px) {
  .eficer-title { font-size: 30px; }
  .eficer-subtitle { font-size: 15px; }
  .eficer-btn { font-size: 15px; padding: 14px 20px; }
}
</style>
