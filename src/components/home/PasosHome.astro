<section class="pasos-home-section">
  <div class="pasos-home-wrap">

    <div class="pasos-home-header">
      <h2 class="pasos-home-title">Cómo eliminar <span>errores y observaciones</span> en auditorías</h2>
      <p class="pasos-home-subtitle">Sin Excel. Sin errores. Sin observaciones.</p>
    </div>

    <div class="pasos-home-grid">

      <div class="paso">
        <div class="paso-number">1</div>
        <div class="paso-icon">📤</div>
        <h3 class="paso-title">Deja atrás el caos en Excel</h3>
        <p class="paso-desc">Importa y organiza tus activos en una sola plataforma con trazabilidad desde el primer día.</p>
        <div class="paso-features">
          <div class="paso-feature">Sin reprocesos</div>
          <div class="paso-feature">Sincronización automática</div>
          <div class="paso-feature">Sin perder datos históricos</div>
        </div>
      </div>

      <div class="paso">
        <div class="paso-number">2</div>
        <div class="paso-icon">🔍</div>
        <h3 class="paso-title">Evita observaciones antes de que ocurran</h3>
        <p class="paso-desc">Controla responsables, movimientos y auditorías con trazabilidad completa.</p>
        <div class="paso-features">
          <div class="paso-feature">Auditorías simplificadas</div>
          <div class="paso-feature">Asignación de responsables</div>
          <div class="paso-feature">Historial de cambios completo</div>
        </div>
      </div>

      <div class="paso">
        <div class="paso-number">3</div>
        <div class="paso-icon">📈</div>
        <h3 class="paso-title">Convierte datos patrimoniales en decisiones seguras</h3>
        <p class="paso-desc">Obtén reportes automáticos, alertas y control ejecutivo en tiempo real.</p>
        <div class="paso-features">
          <div class="paso-feature">Reportes personalizados</div>
          <div class="paso-feature">Alertas automáticas</div>
          <div class="paso-feature">Dashboards ejecutivos</div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
.pasos-home-section {
  background: linear-gradient(135deg, #0f1419 0%, #1a1f2e 100%);
}
.pasos-home-wrap {
  max-width: 1400px;
  margin: 0 auto;
  padding: 80px 2rem 100px;
}

.pasos-home-header {
  text-align: center;
  margin-bottom: 5rem;
}
.pasos-home-title {
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 900;
  color: #f5f5f5;
  margin-bottom: 1rem;
  letter-spacing: -1px;
  line-height: 1.2;
}
.pasos-home-title span {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.pasos-home-subtitle {
  font-size: 1.15rem;
  color: #a0a0a0;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.3;
}

.pasos-home-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 3rem;
  position: relative;
}
@media (min-width: 768px) {
  .pasos-home-grid::before {
    content: '';
    position: absolute;
    top: 80px; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #FF6B35, #4ecdc4, transparent);
    z-index: 0;
  }
}

.paso {
  background: linear-gradient(135deg, rgba(255,107,53,.10), rgba(78,205,196,.05));
  border: 1px solid rgba(255,107,53,.3);
  border-radius: 20px;
  padding: 2.5rem 2rem;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all .3s ease;
  z-index: 1;
}
.paso:hover {
  background: linear-gradient(135deg, rgba(255,107,53,.15), rgba(78,205,196,.10));
  border-color: rgba(255,107,53,.5);
  transform: translateY(-10px);
  box-shadow: 0 20px 40px rgba(255,107,53,.2);
}
.paso-number {
  position: absolute; top: 0; right: 0;
  background: linear-gradient(135deg, #FF6B35, #E55A2B);
  color: #fff;
  width: 60px; height: 60px;
  border-radius: 20px 0 20px 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 2rem; font-weight: 900;
  box-shadow: 0 10px 25px rgba(255,107,53,.3);
}
.paso-icon {
  width: 80px; height: 80px;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  border-radius: 16px;
  display: flex; align-items: center; justify-content: center;
  font-size: 2.5rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 10px 25px rgba(255,107,53,.25);
}
.paso-title {
  font-size: 1.4rem; font-weight: 800;
  color: #f5f5f5; margin-bottom: .75rem;
}
.paso-desc {
  color: #a0a0a0; font-size: .95rem;
  line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;
}
.paso-features { display: flex; flex-direction: column; gap: .75rem; }
.paso-feature {
  display: flex; align-items: flex-start; gap: .75rem;
  font-size: .9rem; color: #a0a0a0;
}
.paso-feature::before {
  content: '✓';
  color: #FF6B35; font-weight: 900; font-size: 1.1rem; flex-shrink: 0;
}

@media (max-width: 768px) {
  .pasos-home-wrap { padding: 60px 1.5rem; }
  .pasos-home-header { margin-bottom: 3rem; }
  .pasos-home-grid { gap: 2rem; }
  .pasos-home-grid::before { display: none; }
  .paso { padding: 2rem 1.5rem; }
  .paso-icon { width: 70px; height: 70px; font-size: 2rem; }
  .paso-title { font-size: 1.2rem; }
}
</style>
