---
const metrics = [
  { n: '50+',  l: 'Clientes' },
  { n: '98%',  l: 'Satisfacción' },
  { n: '16+',  l: 'Años' },
  { n: '24/7', l: 'Soporte' },
];
---

<section class="metrics-outer">
  <div class="metrics-section">
    {metrics.map(m => (
      <div class="metric-item">
        <div class="metric-number">{m.n}</div>
        <div class="metric-label">{m.l}</div>
      </div>
    ))}
  </div>
</section>

<style>
.metrics-outer {
  background: #ffffff;
  padding: 0 2rem 80px;
}
.metrics-section {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
  text-align: center;
  max-width: 1400px;
  margin: 0 auto;
}
.metric-item { padding: 20px 0; }
.metric-number { font-size: 2.5rem; font-weight: 900; color: #FF6B35; }
.metric-label { color: #5f6f75; font-size: .95rem; margin-top: 4px; }

@media (max-width: 600px) {
  .metrics-section { grid-template-columns: repeat(2, 1fr); }
}
</style>
