---
import BaseLayout from '../layouts/BaseLayout.astro';

const waLink = "https://wa.me/51999252787?text=Hola%2C%20quiero%20saber%20c%C3%B3mo%20evitar%20observaciones%20en%20auditor%C3%ADas%20y%20mejorar%20el%20control%20de%20nuestros%20activos.%20%C2%BFPodr%C3%ADan%20orientarme%3F";
---

<BaseLayout
  title="¡Gracias por tu solicitud! — Éficer"
  description="Hemos recibido tu solicitud de demostración. Un especialista se comunicará contigo en menos de 24 horas."
>

  <section class="eficer-thanks-page">
    <div class="eficer-thanks-card">

      <div class="eficer-check">✓</div>

      <span class="eficer-badge">Solicitud enviada correctamente</span>

      <h1>¡Gracias por solicitar tu demostración!</h1>

      <p>
        Hemos recibido correctamente tu información.
        Uno de nuestros especialistas se comunicará contigo
        en menos de 24 horas para coordinar tu demostración personalizada.
      </p>

      <div class="eficer-thanks-boxes">
        <div class="eficer-mini-box">⏱ Atención rápida y personalizada</div>
        <div class="eficer-mini-box">🛡 Información 100% confidencial</div>
      </div>

      <div class="eficer-thanks-buttons">
        <a href={waLink} target="_blank" rel="noopener" class="eficer-btn-primary">
          💬 Hablar por WhatsApp
        </a>
        <a href="/" class="eficer-btn-secondary">
          Volver al inicio
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
.eficer-thanks-page {
  font-family: 'Segoe UI', sans-serif;
  background: linear-gradient(135deg, #003E55 0%, #062733 100%);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 20px;
}

.eficer-thanks-card {
  background: #ffffff;
  max-width: 760px;
  width: 100%;
  border-radius: 34px;
  padding: 70px 60px;
  text-align: center;
  box-shadow: 0 35px 90px rgba(0,0,0,.25);
  position: relative;
  overflow: hidden;
}
.eficer-thanks-card::before {
  content: '';
  position: absolute;
  width: 260px; height: 260px;
  background: radial-gradient(circle, rgba(255,107,53,.18) 0%, rgba(255,107,53,0) 70%);
  top: -100px; right: -80px;
  pointer-events: none;
}

.eficer-check {
  width: 110px; height: 110px;
  margin: 0 auto 28px;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #ff875d);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54px;
  font-weight: 900;
  box-shadow: 0 20px 40px rgba(255,107,53,.28);
}

.eficer-badge {
  display: inline-block;
  background: rgba(255,107,53,.12);
  color: #FF6B35;
  padding: 10px 18px;
  border-radius: 40px;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 22px;
}

.eficer-thanks-card h1 {
  color: #003E55;
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1.08;
  font-weight: 900;
  margin: 0 0 26px;
}

.eficer-thanks-card p {
  color: #5f6f75;
  font-size: 22px;
  line-height: 1.8;
  max-width: 620px;
  margin: 0 auto 38px;
}

.eficer-thanks-boxes {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 42px;
}
.eficer-mini-box {
  background: rgba(0,62,85,.05);
  border-radius: 18px;
  padding: 22px;
  color: #003E55;
  font-size: 17px;
  font-weight: 700;
}

.eficer-thanks-buttons {
  display: flex;
  justify-content: center;
  gap: 18px;
  flex-wrap: wrap;
}
.eficer-btn-primary,
.eficer-btn-secondary {
  text-decoration: none;
  padding: 18px 32px;
  border-radius: 50px;
  font-size: 17px;
  font-weight: 800;
  transition: .3s ease;
}
.eficer-btn-primary {
  background: #FF6B35;
  color: #ffffff;
  box-shadow: 0 18px 40px rgba(255,107,53,.28);
}
.eficer-btn-primary:hover { transform: translateY(-3px); background: #e55a2b; }
.eficer-btn-secondary {
  border: 2px solid #003E55;
  color: #003E55;
  background: #ffffff;
}
.eficer-btn-secondary:hover { background: #003E55; color: #ffffff; transform: translateY(-3px); }

@media (max-width: 767px) {
  .eficer-thanks-card { padding: 50px 28px; border-radius: 26px; }
  .eficer-thanks-card h1 { font-size: 40px; }
  .eficer-thanks-card p { font-size: 18px; }
  .eficer-thanks-boxes { grid-template-columns: 1fr; }
  .eficer-thanks-buttons { flex-direction: column; }
}
</style>
