---
const stats = [
  { n: '50+',  l: 'Clientes' },
  { n: '98%',  l: 'Satisfacción' },
  { n: '16+',  l: 'Años de experiencia' },
  { n: '24/7', l: 'Soporte' },
];

const clientes = ['SUNARP', 'Mun. Lurigancho', 'PSI', 'SENACE', 'OSITRAN', 'ACENESPAR', 'BNP', 'ALISUR'];
---

<section class="section section-alt">
  <div class="container">
    <div class="section-header center">
      <div class="section-tag">Resultados reales</div>
      <h2 class="section-title">Más de 50 instituciones ya usan Éficer</h2>
      <p class="section-sub">Resultados reales en instituciones como la tuya.</p>
    </div>

    <div class="cp-stats">
      {stats.map(s => (
        <div class="cp-stat">
          <div class="cp-stat-n">{s.n}</div>
          <div class="cp-stat-l">{s.l}</div>
        </div>
      ))}
    </div>

    <div class="cp-logos">
      {clientes.map(c => (
        <div class="cp-logo-chip">{c}</div>
      ))}
    </div>

    <div class="cp-cta">
      <a href="/casos-de-exito" class="btn btn-outline">Ver casos de éxito →</a>
    </div>
  </div>
</section>

<style>
.cp-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 48px;
}
.cp-stat {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 20px;
  text-align: center;
  box-shadow: var(--shadow);
}
.cp-stat-n { font-size: 2.2rem; font-weight: 900; color: var(--blue); }
.cp-stat-l { font-size: .85rem; color: var(--text-2); margin-top: 4px; }

.cp-logos {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  margin-bottom: 40px;
}
.cp-logo-chip {
  font-size: .82rem;
  font-weight: 600;
  background: #fff;
  border: 1px solid var(--border);
  color: var(--text-2);
  padding: 6px 16px;
  border-radius: 999px;
}
.cp-cta { text-align: center; }

@media (max-width: 720px) { .cp-stats { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 400px) { .cp-stats { grid-template-columns: 1fr; } }
</style>
