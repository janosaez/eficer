---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pasos from '../components/como-funciona/Pasos.astro';
---

<BaseLayout
  title="Cómo funciona"
  description="Conoce el proceso de 3 pasos con el que Éficer transforma el control patrimonial de tu institución."
>
  <!-- Page hero -->
  <section class="cf-hero section section-alt">
    <div class="container">
      <div class="section-tag">Proceso</div>
      <h1 class="section-title">Cómo funciona Éficer</h1>
      <p class="section-sub">
        Desde la importación de tus datos hasta los reportes automáticos,
        te guiamos en cada paso para que tu institución esté lista antes de la próxima auditoría.
      </p>
      <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
        <a href="/contacto" class="btn btn-primary">Solicitar Demo Gratuita</a>
        <a href="/casos-de-exito" class="btn btn-outline">Ver casos de éxito</a>
      </div>
    </div>
  </section>

  <Pasos />

  <!-- CTA Final -->
  <section class="section section-alt">
    <div class="container" style="text-align:center;max-width:600px">
      <div class="section-tag">¿Listo?</div>
      <h2 class="section-title">Empieza hoy mismo</h2>
      <p class="section-sub" style="margin:0 auto 28px">
        Agenda tu demo personalizada y verás en vivo cómo Éficer funciona con tus datos reales.
      </p>
      <a href="/contacto" class="btn btn-primary">Agendar mi demostración →</a>
    </div>
  </section>
</BaseLayout>

<style>
.cf-hero { padding: 64px 0; }
</style>
